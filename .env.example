# Neon Postgres (private Vercel environment variables only)
DATABASE_URL=

# Generate with: npm run hash-admin-password -- "your password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_ALLOWED_ORIGIN=https://your-vercel-domain.example

# Heartbeat -> Vercel dispatch authentication
NOTIFICATION_DISPATCH_TOKEN=

# DingTalk internal application
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
# Exact test recipient allowed by the admin test-send endpoint.
DINGTALK_TEST_USER_ID=
# Optional department ids used for name search; manual userId entry remains available.
DINGTALK_DIRECTORY_DEPARTMENT_IDS=1

# Stable public report entry included in test and daily work notifications.
PUBLIC_REPORT_URL=https://your-vercel-domain.example/reports/latest

# Safety gate: keep false until the designated test user has passed real-send acceptance.
DINGTALK_PRODUCTION_SEND_ENABLED=false
